#!/usr/bin/env bash
# kit runner. Owned by kit. Runs a named command from .kit.toml [commands].
# Usage: .kit/run <install|test|lint|format|typecheck|build|run|guard> [args]
set -euo pipefail
cd "$(dirname "$0")/.."
task="${1:-}"
[ $# -gt 0 ] && shift

case "$task" in
  "")
    echo "usage: .kit/run <install|test|lint|format|typecheck|build|run|guard> [args]" >&2
    exit 2 ;;
  guard)
    fail() { echo "guard: $1" >&2; exit 1; }
    [ -f .kit.toml ] || fail "missing .kit.toml"
    [ -f docs/architecture.md ] || fail "missing docs/architecture.md"
    if git ls-files --error-unmatch .env >/dev/null 2>&1; then fail ".env is tracked by git"; fi
    if grep -rIlE --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=.venv --exclude-dir=dist \
        -e 'AKIA[0-9A-Z]{16}' -e 'sk_live_[0-9A-Za-z]{10,}' -e 'BEGIN (RSA|OPENSSH|EC) PRIVATE KEY' . >/dev/null; then
      fail "possible secret in tracked files"
    fi
    echo "guard: ok"
    exit 0 ;;
esac

cmd="$(python3 - "$task" <<'PY'
import sys, tomllib
with open(".kit.toml", "rb") as f:
    commands = tomllib.load(f).get("commands", {})
print(commands.get(sys.argv[1], ""))
PY
)"

if [ -z "$cmd" ] || [ "$cmd" = "not set, run /setup-stack" ]; then
  echo "$task: no command configured. Run /setup-stack in Claude, or set [commands].$task in .kit.toml." >&2
  exit 1
fi
if [ "$cmd" = "skip" ]; then
  echo "$task: skipped by configuration"
  exit 0
fi
exec bash -c "$cmd"' "$@"' -- "$@"
