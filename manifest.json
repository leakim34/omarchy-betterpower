{
  "schemaVersion": 1,
  "id": "leakz.betterpower",
  "name": "BetterPower",
  "version": "0.3.0",
  "author": "leakz",
  "license": "MIT",
  "description": "Power profile, screensaver, lock and sleep per power source, battery protection, clamshell lid control, and a bar-wide battery gauge",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "BetterPower",
    "description": "Per-source power strategy, battery protection, clamshell, bar battery gauge",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "batteryProfile": "power-saver",
      "batteryScreensaver": 120,
      "batteryLock": 300,
      "batterySleep": 600,
      "acProfile": "performance",
      "acScreensaver": 0,
      "acLock": 0,
      "acSleep": 0,
      "clamshell": "On",
      "barMode": "off"
    },
    "schema": [
      {
        "key": "batteryProfile",
        "type": "enum",
        "label": "On battery: power profile",
        "options": [
          "power-saver",
          "balanced",
          "performance"
        ],
        "defaultValue": "power-saver"
      },
      {
        "key": "batteryScreensaver",
        "type": "integer",
        "label": "On battery: screensaver after (seconds, 0 = never)",
        "min": 0,
        "max": 86400,
        "step": 30,
        "defaultValue": 120
      },
      {
        "key": "batteryLock",
        "type": "integer",
        "label": "On battery: lock after (seconds, 0 = never)",
        "min": 0,
        "max": 86400,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "batterySleep",
        "type": "integer",
        "label": "On battery: sleep after lock (seconds, 0 = never)",
        "min": 0,
        "max": 86400,
        "step": 30,
        "defaultValue": 600
      },
      {
        "key": "acProfile",
        "type": "enum",
        "label": "Plugged in: power profile",
        "options": [
          "power-saver",
          "balanced",
          "performance"
        ],
        "defaultValue": "performance"
      },
      {
        "key": "acScreensaver",
        "type": "integer",
        "label": "Plugged in: screensaver after (seconds, 0 = never)",
        "min": 0,
        "max": 86400,
        "step": 30,
        "defaultValue": 0
      },
      {
        "key": "acLock",
        "type": "integer",
        "label": "Plugged in: lock after (seconds, 0 = never)",
        "min": 0,
        "max": 86400,
        "step": 30,
        "defaultValue": 0
      },
      {
        "key": "acSleep",
        "type": "integer",
        "label": "Plugged in: sleep after lock (seconds, 0 = never)",
        "min": 0,
        "max": 86400,
        "step": 30,
        "defaultValue": 0
      },
      {
        "key": "clamshell",
        "type": "enum",
        "label": "Keep running when the lid closes on an external screen",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "barMode",
        "type": "enum",
        "label": "Bar icon extra (right click cycles): nothing, the percentage, a battery gauge painted across the bar, or both",
        "options": [
          "off",
          "percentage",
          "gauge",
          "both"
        ],
        "defaultValue": "off"
      }
    ]
  }
}
